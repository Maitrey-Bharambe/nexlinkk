# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000

# Local:  mongodb://127.0.0.1:27017/nexlink   (npm run dev:mongo, docker compose, or a local mongod)
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexlink?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nexlink

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000
# Defaults to true in production. Must be true behind HTTPS.
# COOKIE_SECURE=false
# Set to true only when running behind a reverse proxy you control.
TRUST_PROXY=false
LOG_LEVEL=info

# Self-service signup. First account becomes admin, later ones operators (own networks only).
ALLOW_SIGNUP=true
SESSION_TTL_HOURS=12
# scrypt cost (OWASP: N=2^17). Lower only for tests.
PASSWORD_SCRYPT_N=131072
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

ENROLLMENT_TOKEN_TTL_MINUTES=15
HEARTBEAT_INTERVAL_SECONDS=30
AGENT_CLOCK_SKEW_SECONDS=120
HANDSHAKE_FRESH_SECONDS=180

MEASUREMENT_RETENTION_DAYS=7
HEARTBEAT_RETENTION_DAYS=3
# 0 disables the background incident detector.
INCIDENT_DETECTOR_INTERVAL_SECONDS=30

# Optional Python diagnostic service. Unset = deterministic rules only.
# DIAGNOSTIC_SERVICE_URL=http://127.0.0.1:8090
DIAGNOSTIC_SERVICE_TIMEOUT_MS=15000
