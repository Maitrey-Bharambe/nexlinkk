# Copy to .env and adjust. Never commit .env.
# One process serves the console, the REST API, Socket.IO and the agent relay.
NODE_ENV=development
PORT=3000

# Leave unset in development: `npm run dev` then uses the MongoDB already on
# 127.0.0.1:27017, or starts an embedded one (data in .data/mongo).
# Required in production, e.g. MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexlink?retryWrites=true&w=majority
# MONGODB_URI=

# The address invited computers use to reach this portal, e.g. https://nexlink.example.com.
# Unset = whatever address the browser used. Set it whenever you deploy behind HTTPS / a proxy.
# PUBLIC_URL=

# Defaults to true in production. Must be true behind HTTPS.
# COOKIE_SECURE=false
# Set to true only when running behind a reverse proxy you control (Render, Fly, nginx, Caddy...).
TRUST_PROXY=false
LOG_LEVEL=info

# Self-service signup. First account becomes admin, later ones operators (own networks only).
ALLOW_SIGNUP=true
SESSION_TTL_HOURS=12
# scrypt cost (OWASP: N=2^17). Lower only for tests.
PASSWORD_SCRYPT_N=131072
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

ENROLLMENT_TOKEN_TTL_MINUTES=15
HEARTBEAT_INTERVAL_SECONDS=30
AGENT_CLOCK_SKEW_SECONDS=120
HANDSHAKE_FRESH_SECONDS=180

MEASUREMENT_RETENTION_DAYS=7
HEARTBEAT_RETENTION_DAYS=3
# 0 disables the background incident detector.
INCIDENT_DETECTOR_INTERVAL_SECONDS=30

# Encrypted relay: devices that cannot reach each other directly (NAT, CGNAT,
# firewalls, mobile networks) exchange WireGuard ciphertext through this server.
RELAY_ENABLED=true
RELAY_MAX_BYTES_PER_SECOND=4194304

# Python diagnostic service (AI briefings, "ask ai", "analyze with AI").
# Development: started automatically from ../diagnostic-service/.venv when that
# exists (AI_AUTOSTART=false to opt out). Production: point at the deployed service.
# DIAGNOSTIC_SERVICE_URL=http://127.0.0.1:8090
DIAGNOSTIC_SERVICE_TIMEOUT_MS=15000
AI_AUTOSTART=true
# AI network briefings: checked on this interval, regenerated only when a
# network's observed state changed (or after 6 h). 0 disables the schedule.
BRIEFING_INTERVAL_MINUTES=10
