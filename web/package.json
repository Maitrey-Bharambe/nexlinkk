{
  "name": "nexlink",
  "version": "0.3.0",
  "private": true,
  "description": "NexLink: console + control plane in one Next.js app. One process, one port, one deploy.",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "node server.js --production",
    "lint": "next lint",
    "dev:mongo": "node scripts/dev-mongo.js",
    "create-user": "node scripts/create-user.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.8.1",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.8.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0"
  }
}
