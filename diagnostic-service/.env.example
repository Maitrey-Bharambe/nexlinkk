# Copy to .env (same folder) and fill in. .env is git-ignored — never commit your key.

# mock = built-in rule-based answers (no key needed); groq = real LLM via Groq
NEXLINK_DIAG_PROVIDER=groq

# From https://console.groq.com/keys
GROQ_API_KEY=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b   (alternatives: openai/gpt-oss-20b, qwen/qwen3.8-27b)
